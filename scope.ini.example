quality = 95

[style:mixrbv2]
recipe = mixrbv2
quality = 65

; Screenshot packs: installed next to the boxes, not instead of them, so each
; has its own folder and db_id (<prefix><system>-<folder>). PNG at native
; size, never resampled; above one card block an image drops to 256 colours
; unless its system is listed in 'lossless'. A JPEG source is taken only when
; no later source of the recipe has a PNG.
;   ss, sstitle            ScreenScraper media
;   lr-snaps, lr-titles    libretro-thumbnails folders (needs libretro =)
[style:snap]
recipe = ss > lr-snaps
format = png
folder = Screenshots
; SS has no blank template for screenshots, and series discs legitimately
; share one screen (Aquazone option discs, EPS Series): keep them all
placeholder_min = 0
; N64: SS serves 640x480 renders, kept whole on purpose at 2-3 blocks each;
; Saturn: libretro's filtered 512x384 would lose colours on top of the filter
lossless = N64, Saturn

[style:title]
recipe = sstitle > lr-titles
format = png
folder = Titles
placeholder_min = 0
lossless = N64, Saturn